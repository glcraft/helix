+
+    impl Custom for TreeSitterNode {
+        fn fmt(&self) -> Option<std::result::Result<String, std::fmt::Error>> {
+            if self.is_visible() {
+                return Some(Ok(format!("#TSNode<({:?})>", self.kind())));
+            }
