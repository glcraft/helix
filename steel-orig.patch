+fn filter_null_values(value: &mut Value) {
+    match value {
+        Value::Object(map) => {
+            map.retain(|_, v| {
+                if v.is_null() {
+                    false
+                } else {
+                    filter_null_values(v);
+                    true
+                }
+            });
+        }
+        Value::Array(arr) => {
+            arr.retain_mut(|v| {
+                if v.is_null() {
+                    false
+                } else {
+                    filter_null_values(v);
+                    true
+                }
+            });
+        }
+        Value::Number(n) => {
+            if let Some(f) = n.as_f64() {
+                *n = (f.round() as i64).into();
+            }
+        }
+        _ => {}
+    }
+}
