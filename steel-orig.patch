+        .register_fn_with_ctx(CTX, "regex-selection", regex_selection)
+        .register_fn_with_ctx(CTX, "replace-selection-with", replace_selection)
+        .register_fn_with_ctx(
+            CTX,
+            "enqueue-expression-in-engine",
