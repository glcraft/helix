+pub fn format_docstring(doc: &str) -> String {
+    let mut docstring = doc
+        .lines()
+        .map(|x| {
+            let mut line = ";;".to_string();
+            line.push_str(x);
+            line.push('\n');
+            line
+        })
+        .collect::<String>();
+
+    docstring.pop();
+
+    docstring
+}
